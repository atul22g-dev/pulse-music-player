[TEMPLATE]
# Copy to .env.local to use per-environment secrets (Vite exposes VITE_* vars).

# Atual API key — the playlist list is fetched from
# https://apis-atual-dev.vercel.app/api/playlists with this key (sent as the
# X-API-Key header and the api_key query param). Can also be pasted at runtime
# in Settings → Playlist API (saved locally) instead of using the env var.
# Response shape: { "data": [{ "playlistId": "PL...", "name": "...",
# "description": "..." }] }. YouTube sync itself needs no API key.
VITE_ATUAL_API_KEY=

# Optional override for the playlist API URL (defaults to the Atual endpoint).
VITE_PLAYLISTS_API_URL=
